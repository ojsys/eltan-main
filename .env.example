# ============================================================================
# ELTAN Project - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!
# ============================================================================

# ============================================================================
# Django Settings
# ============================================================================
# SECURITY WARNING: keep the secret key used in production secret!
# Generate a new secret key using:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Environment: development, staging, or production
ELTAN_ENV=development
DJANGO_SETTINGS_MODULE=eltanweb.settings.development

# Debug mode (NEVER set to True in production!)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# Database Configuration
# ============================================================================
# For Development (SQLite - no configuration needed)
# Database is automatically created at db.sqlite3

# For Production (MySQL/PostgreSQL)
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# ============================================================================
# Paystack Payment Gateway
# ============================================================================
# Get your keys from https://dashboard.paystack.com/settings/developer

# Live Keys (Production)
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here

# Test Keys (Development/Testing)
# PAYSTACK_TEST_SECRET_KEY=sk_test_your_test_secret_key_here
# PAYSTACK_TEST_PUBLIC_KEY=pk_test_your_test_public_key_here

# ============================================================================
# Email Configuration
# ============================================================================
# Conference tickets, receipts and membership notifications all go out over these
# settings. After changing anything here, verify it with:
#     python manage.py test_email --to you@example.com
#
# --- SMTP server ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Set EMAIL_USE_SSL=True and EMAIL_PORT=465 instead if your provider requires SSL.
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20

# --- Credentials ---
# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD are preferred; USER_EMAIL / USER_PASSWORD
# are still read as fallbacks so older .env files keep working.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
USER_EMAIL=your-email@gmail.com
USER_PASSWORD=your-app-specific-password

# --- Sender address ---
# IMPORTANT: the From: address must be one your provider has authorised, or the
# mail is rejected and no receipt or ticket is delivered. Two cases:
#
#  * Mailbox providers (Gmail, Zoho, cPanel mail): the authenticated account is
#    itself a valid sender, so DEFAULT_FROM_EMAIL can be left unset.
#
#  * Relay providers (Brevo, SendGrid, Amazon SES): EMAIL_HOST_USER is an account
#    ID like 'b479b8001@smtp-brevo.com' and is NEVER a valid sender. You MUST set
#    DEFAULT_FROM_EMAIL to an address you verified in the provider's dashboard.
#
# DEFAULT_FROM_EMAIL=ELTAN <nationalsec@eltanigeria.org>

# Address shown to members for support, and used as the Reply-To on receipts.
CONTACT_EMAIL=nationalsec@eltanigeria.org

# For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an app-specific password (16 characters, no spaces)
# 3. Use that app password here (not your regular password)
#
# For Brevo (https://app.brevo.com -> SMTP & API):
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=<your login, e.g. b479b8001@smtp-brevo.com>
#   EMAIL_HOST_PASSWORD=<your SMTP key — not your Brevo account password>
#   DEFAULT_FROM_EMAIL=ELTAN <nationalsec@eltanigeria.org>
# and in Brevo under "Senders, Domains & Dedicated IPs" either verify that exact
# sender address or authenticate the eltanigeria.org domain (SPF/DKIM). Verifying
# the whole domain is worth doing — it lets you send as any @eltanigeria.org
# address and materially improves deliverability.
#
# After any change here, confirm it works:
#   python manage.py test_email --to you@example.com

# ============================================================================
# Site Configuration
# ============================================================================
SITE_NAME=ELTAN
SITE_URL=http://localhost:8000

# Production URL
# SITE_URL=https://www.eltanigeria.org

# ============================================================================
# Notes for Setup
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in all the values above with your actual credentials
# 3. Never commit your actual .env file to version control
# 4. Keep your SECRET_KEY secret and unique
# 5. Use test Paystack keys for development
# 6. In production, set DEBUG=False
# 7. Configure proper ALLOWED_HOSTS in production
# ============================================================================
